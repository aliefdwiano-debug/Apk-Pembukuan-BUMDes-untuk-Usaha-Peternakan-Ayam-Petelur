# Environment Variables Example for Aplikasi Pembukuan BUMDes

# Gemini API Key (for AI features if server-side Gemini is configured)
GEMINI_API_KEY=

# Supabase Configuration
# Masukkan Project URL dan API Key dari dashboard Supabase Anda (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
