# Environment Variables untuk Aplikasi Pembukuan BUMDes (frontend static / GitHub Pages)
#
# Hanya variabel berprefix VITE_ yang di-bundle ke aplikasi frontend oleh Vite.
# JANGAN PERNAH memasukkan Supabase Service Role Key di sini atau di mana pun pada kode frontend.

# Masukkan Project URL dan anon/publishable key dari dashboard Supabase Anda
# (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
